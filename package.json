{
  "name": "sandboxed-javascript-expressions",
  "version": "0.11.1",
  "description": "Allows evaluating untrusted javascript expressions in a nodejs server and in browsers",
  "main": "./dist/sandboxed-javascript-expressions.cjs.js",
  "module": "./dist/index.mjs",
  "browser": "./dist/sandboxed-javascript-expressions.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/sandboxed-javascript-expressions.umd.js",
      "import": "./dist/index.mjs",
      "require": "./dist/sandboxed-javascript-expressions.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "test": "tsa ci",
    "dist": "tsc -p ./src/tsconfig.json && rollup -c",
    "prepublishOnly": "tsa clean && npm -s run dist",
    "assist": "tsa assist",
    "release": "tsa release",
    "fix": "tsa fix",
    "fixall": "tsa fixall",
    "clean": "tsa clean",
    "ci": "tsa ci",
    "coverage-show": "opn build/coverage/index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johan-gorter/sandboxed-javascript-expressions.git"
  },
  "keywords": [
    "sandbox",
    "javascript",
    "expressions",
    "nodejs",
    "node",
    "browser"
  ],
  "author": "Johan Gorter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johan-gorter/sandboxed-javascript-expressions/issues"
  },
  "homepage": "https://github.com/johan-gorter/sandboxed-javascript-expressions#readme",
  "devDependencies": {
    "husky": "9.1.7",
    "rollup": "4.62.5",
    "typescript-assistant": "0.74.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "diff": "9.0.0",
    "file-type": "22.0.2",
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.5",
    "serialize-javascript": "7.1.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "lcov",
      "html",
      "text-summary"
    ],
    "cache": true,
    "temp-directory": "./build/nyc/cache",
    "all": false,
    "check-coverage": true,
    "report-dir": "./build/coverage",
    "es-module": false,
    "lines": 75,
    "statements": 75,
    "functions": 75,
    "branches": 75,
    "watermarks": {
      "lines": [
        75,
        100
      ],
      "functions": [
        75,
        100
      ],
      "branches": [
        75,
        100
      ],
      "statements": [
        75,
        100
      ]
    }
  },
  "importSort": {
    ".js, .jsx, .ts, .tsx": {
      "style": "module",
      "parser": "typescript"
    }
  }
}
